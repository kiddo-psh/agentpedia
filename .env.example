# Copy to .env.local and fill in. Everything is optional for local dev.

# Postgres connection string (Supabase/Neon). Unset -> embedded PGlite in .data/
DATABASE_URL=

# Better Auth. Required in production: a long random string (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Public site URL, e.g. https://agentpedia.example
BETTER_AUTH_URL=

# GitHub OAuth app (https://github.com/settings/developers)
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
# Unset in dev -> a dev-only email/password login appears instead.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Salt for daily visitor hashes in analytics events
EVENT_SALT=

# Bearer token for GET /api/metrics in production (unset -> metrics are dev-only)
METRICS_TOKEN=

# 1 -> show draft articles in a production build (preview deploys)
SHOW_DRAFTS=
